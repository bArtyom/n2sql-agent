# HTTP server
SERVER_ADDRESS=:8080

# Local PostgreSQL
POSTGRES_DB=knowledgebase
POSTGRES_USER=knowledgebase
POSTGRES_PASSWORD=knowledgebase
POSTGRES_PORT=5432
DATABASE_URL=postgres://knowledgebase:knowledgebase@localhost:5432/knowledgebase?sslmode=disable

# Local directory for uploaded source files. It is ignored by Git.
UPLOAD_DIR=./.data/uploads

WORKER_POLL_INTERVAL=2s

# Optional short-lived Agent event stream. When configured, token deltas,
# thinking and tool progress use Redis instead of PostgreSQL event rows.
# Final answers and run state are still stored in PostgreSQL.
AGENT_STREAM_REDIS_URL=redis://localhost:6379/0
AGENT_STREAM_TTL=1h
AGENT_STREAM_MAX_LEN=4096

# Agent checkpoint storage. Small tool results stay in PostgreSQL checkpoint
# metadata; large results are written to this temporary directory and referenced
# from PostgreSQL. Redis remains the short-lived event stream.
AGENT_CHECKPOINT_DIR=./.data/agent-checkpoints
AGENT_CHECKPOINT_INLINE_BYTES=8192
AGENT_CHECKPOINT_FILE_TTL=1h
AGENT_CHECKPOINT_CLEANUP_INTERVAL=10m

# Optional Go runtime diagnostics. Leave empty to keep pprof disabled.
# Bind to loopback only in local development; do not expose publicly.
PPROF_ADDRESS=


# Agent execution guard: maximum model/tool rounds per agent request.
AGENT_MAX_STEPS=4
# Maximum wall-clock time for one Agent request.
AGENT_TIMEOUT_MS=60000
# Maximum wall-clock time for one asynchronous child Agent run.
AGENT_CHILD_TIMEOUT=30m
MODEL_PROVIDER_TIMEOUT_MS=120000
DOCUMENT_SUMMARY_MAX_INPUT_CHARS=30000
# Maximum serialized knowledge-search result size sent to the model.
AGENT_MAX_TOOL_RESULT_BYTES=32768
# Maximum client-provided conversation messages retained for one Agent run.
AGENT_MAX_HISTORY_MESSAGES=10
# Maximum UTF-8 content bytes retained from conversation history.
AGENT_MAX_HISTORY_BYTES=16384
# Use the chat model to summarize older history when the context window is full.
AGENT_HISTORY_SUMMARY_ENABLED=true
# Maximum time for one semantic history-summary call.
AGENT_HISTORY_SUMMARY_TIMEOUT_MS=10000

# Process-local retrieval result cache. It caches retrieval/rerank results,
# never the final chat answer. A document re-index clears its knowledge base.
RETRIEVAL_CACHE_ENTRIES=128
RETRIEVAL_CACHE_TTL=2m

# Model Provider secret (never stored in PostgreSQL)
OPENAI_API_KEY=

# Optional rerank model. Leave the provider fields empty to keep hybrid recall
# without a second model request. Configure the rerank base URL and model in
# the model provider settings page when you want model-based reranking.

# Only this environment variable can be selected by the Provider API. Connection
# tests may only send its value to these comma-separated HTTPS model-service hosts.
MODEL_PROVIDER_API_KEY_ENV_VAR=OPENAI_API_KEY
MODEL_PROVIDER_ALLOWED_HOSTS=api.openai.com

# Optional local OpenAI-compatible embedding server (for example Ollama).
# Leave LOCAL_EMBEDDING_BASE_URL and LOCAL_EMBEDDING_MODEL empty to use the
# embedding model configured in the model provider settings page.
LOCAL_EMBEDDING_BASE_URL=
LOCAL_EMBEDDING_MODEL=
LOCAL_EMBEDDING_API_KEY=ollama

# Optional scanned-PDF OCR. Leave OCR_MODEL empty to keep OCR disabled.
# OCR_MODEL must be a vision-capable model exposed by the configured provider.
OCR_MODEL=
OCR_PROMPT=请只转写图片中清晰可见的文字，保留原有段落和表格结构，不要解释或补充内容。
OCR_RENDERER_BIN=pdftoppm
OCR_RENDER_DPI=150
OCR_MAX_PAGES=20
OCR_CONCURRENCY=1

# Optional parser engine override. Empty means each knowledge base rule or
# MIME-based automatic selection decides the engine.
DOCUMENT_PARSER_ENGINE=

# Optional normalized remote parser adapter. The service receives multipart
# field `file` and returns {markdown, images, metadata} JSON. Keep the host
# allowlist narrow; the adapter rejects other hosts to avoid SSRF.
DOCUMENT_PARSER_REMOTE_URL=
DOCUMENT_PARSER_REMOTE_ENGINE=remote_http
DOCUMENT_PARSER_ALLOWED_HOSTS=localhost,127.0.0.1,::1
DOCUMENT_PARSER_REMOTE_TIMEOUT=10m
