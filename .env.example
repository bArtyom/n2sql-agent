# HTTP server
SERVER_ADDRESS=:8080

# Structured application logs. The Go server keeps stdout and appends JSONL
# here so the optional Grafana Alloy container can collect local-run logs.
LOG_FILE_PATH=./.data/logs/server.jsonl

# Local PostgreSQL
POSTGRES_DB=knowledgebase
POSTGRES_USER=knowledgebase
POSTGRES_PASSWORD=knowledgebase
POSTGRES_PORT=5432
DATABASE_URL=postgres://knowledgebase:knowledgebase@localhost:5432/knowledgebase?sslmode=disable

# Optional local observability stack: docker compose --profile observability up -d
LOKI_PORT=3100
ALLOY_PORT=12345
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Local directory for uploaded source files. It is ignored by Git.
UPLOAD_DIR=./.data/uploads
# Optional S3-compatible storage (MinIO/OSS gateway). Leave endpoint empty for local storage.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_BUCKET=

WORKER_POLL_INTERVAL=2s
# Number of concurrent Agent Run workers in this server process. All workers
# claim from the same PostgreSQL queue; keep this aligned with DB/model capacity.
AGENT_WORKER_CONCURRENCY=1
DOCUMENT_WORKER_CONCURRENCY=2
QUEUE_BACKLOG_WARNING_THRESHOLD=1000

# Optional short-lived Agent event stream. When configured, token deltas,
# thinking and tool progress use Redis instead of PostgreSQL event rows.
# Final answers and run state are still stored in PostgreSQL.
AGENT_STREAM_REDIS_URL=redis://localhost:6379/0
AGENT_STREAM_TTL=1h
AGENT_STREAM_MAX_LEN=4096

# Agent checkpoint storage. Small tool results stay in PostgreSQL checkpoint
# metadata; large results are written to this temporary directory and referenced
# from PostgreSQL. Redis remains the short-lived event stream.
AGENT_CHECKPOINT_DIR=./.data/agent-checkpoints
AGENT_CHECKPOINT_INLINE_BYTES=8192
AGENT_CHECKPOINT_FILE_TTL=1h
AGENT_CHECKPOINT_CLEANUP_INTERVAL=10m

# Optional Go runtime diagnostics. Leave empty to keep pprof disabled.
# Bind to loopback only in local development; do not expose publicly.
PPROF_ADDRESS=


# Agent execution guard: maximum model/tool rounds per agent request.
AGENT_MAX_STEPS=4
# Maximum wall-clock time for one Agent request.
AGENT_TIMEOUT_MS=60000
# Maximum wall-clock time for one asynchronous child Agent run.
AGENT_CHILD_TIMEOUT=30m
MODEL_PROVIDER_TIMEOUT_MS=120000
DOCUMENT_SUMMARY_MAX_INPUT_CHARS=30000
# Maximum serialized knowledge-search result size sent to the model.
AGENT_MAX_TOOL_RESULT_BYTES=32768
# Maximum client-provided conversation messages retained for one Agent run.
AGENT_MAX_HISTORY_MESSAGES=10
# Maximum UTF-8 content bytes retained from conversation history.
AGENT_MAX_HISTORY_BYTES=16384
# Optional DeerFlow-style Skill catalog. Each immediate or nested directory
# contains a SKILL.md with YAML frontmatter; the body is loaded on demand.
AGENT_SKILLS_DIR=./skills
# Use the chat model to summarize older history when the context window is full.
AGENT_HISTORY_SUMMARY_ENABLED=true
# Maximum time for one semantic history-summary call.
AGENT_HISTORY_SUMMARY_TIMEOUT_MS=10000

# Optional Manus-style code execution sandbox. Disabled by default. Requires
# Docker Desktop (or another Docker-compatible runtime) on the server host.
# The model can only submit Python code; network, host files and the resource
# budget are controlled by the backend and cannot be changed by the model.
SANDBOX_ENABLE=false
SANDBOX_DOCKER_BIN=docker
SANDBOX_IMAGE=python:3.12-alpine
SANDBOX_TIMEOUT=30s
SANDBOX_MEMORY_BYTES=536870912
SANDBOX_CPUS=1
SANDBOX_PIDS_LIMIT=64
SANDBOX_DISK_BYTES=104857600
SANDBOX_MAX_OUTPUT_BYTES=131072
SANDBOX_MAX_CODE_BYTES=65536
SANDBOX_MAX_CONCURRENT=2

# Process-local retrieval result cache. It caches retrieval/rerank results,
# never the final chat answer. A document re-index clears its knowledge base.
RETRIEVAL_CACHE_ENTRIES=128
RETRIEVAL_CACHE_TTL=2m

# Optional GraphRAG sidecar. It is disabled by default; when enabled,
# document chunks are extracted asynchronously into Neo4j and query entities
# trigger one-hop graph recall before the existing Hybrid RAG rerank.
NEO4J_ENABLE=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Model Provider secret (never stored in PostgreSQL)
OPENAI_API_KEY=

# Optional rerank model. Leave the provider fields empty to keep hybrid recall
# without a second model request. Configure the rerank base URL and model in
# the model provider settings page when you want model-based reranking.

# Only this environment variable can be selected by the Provider API. Connection
# tests may only send its value to these comma-separated HTTPS model-service hosts.
MODEL_PROVIDER_API_KEY_ENV_VAR=OPENAI_API_KEY
MODEL_PROVIDER_ALLOWED_HOSTS=api.openai.com
# Local process circuit breaker for each provider and capability (chat,
# embedding, OCR, rerank). A capability is opened after this many retryable
# failures, then one probe is allowed after the recovery timeout.
MODEL_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
MODEL_CIRCUIT_BREAKER_RECOVERY_TIMEOUT=30s

# Optional local OpenAI-compatible embedding server (for example Ollama).
# Leave LOCAL_EMBEDDING_BASE_URL and LOCAL_EMBEDDING_MODEL empty to use the
# embedding model configured in the model provider settings page.
LOCAL_EMBEDDING_BASE_URL=
LOCAL_EMBEDDING_MODEL=
LOCAL_EMBEDDING_API_KEY=ollama

# Optional multimodal image embedding sidecar. The endpoint must accept the
# OpenAI-compatible /v1/embeddings request with object inputs such as
# {"image":"data:image/png;base64,..."}. Leave empty to disable image-vector
# recall; OCR/Caption text retrieval remains available.
MULTIMODAL_EMBEDDING_BASE_URL=
MULTIMODAL_EMBEDDING_MODEL=
MULTIMODAL_EMBEDDING_API_KEY=

# Optional scanned-PDF OCR. Leave OCR_MODEL empty to keep OCR disabled.
# OCR_MODEL must be a vision-capable model exposed by the configured provider.
OCR_MODEL=
OCR_PROMPT=请只转写图片中清晰可见的文字，保留原有段落和表格结构，不要解释或补充内容。
# Optional second VLM pass for image captions. Leave empty to avoid the extra model call.
IMAGE_CAPTION_PROMPT=
OCR_RENDERER_BIN=pdftoppm
OCR_RENDER_DPI=150
OCR_MAX_PAGES=20
OCR_CONCURRENCY=1
# Shared document post-processing queue: summary, image OCR/Caption,
# recommendations, FAQ and Wiki extensions.
POSTPROCESS_TASK_CONCURRENCY=2
POSTPROCESS_TASK_MAX_ATTEMPTS=3
POSTPROCESS_TASK_LEASE=5m

# Optional parser engine override. Empty means each knowledge base rule or
# MIME-based automatic selection decides the engine.
DOCUMENT_PARSER_ENGINE=

# Optional normalized remote parser adapter. The service receives multipart
# field `file` and returns {markdown, images, metadata} JSON. Keep the host
# allowlist narrow; the adapter rejects other hosts to avoid SSRF.
DOCUMENT_PARSER_REMOTE_URL=
DOCUMENT_PARSER_REMOTE_ENGINE=remote_http
DOCUMENT_PARSER_ALLOWED_HOSTS=localhost,127.0.0.1,::1
DOCUMENT_PARSER_REMOTE_TIMEOUT=10m
DOCUMENT_PARSER_MINERU_URL=
DOCUMENT_PARSER_PADDLEOCR_VL_URL=
# Optional WeKnora Cloud signed parser. The API key is backend-only.
WEKNORA_CLOUD_PARSER_URL=https://weknora.weixin.qq.com/api/v1/doc
WEKNORA_CLOUD_APP_ID=
WEKNORA_CLOUD_API_KEY=

# Optional standalone DocReader process. When configured, document Worker
# parsing runs through gRPC instead of inside the main HTTP process.
# Start it with: go run ./cmd/docreader
DOCUMENT_READER_GRPC_URL=
DOCREADER_ADDRESS=127.0.0.1:50051
DOCUMENT_READER_GRPC_TIMEOUT=15m
DOCUMENT_READER_GRPC_RETRY_ATTEMPTS=2
DOCUMENT_READER_FALLBACK_LOCAL=true
